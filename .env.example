## Add your env variables here, this repo does not require any
FAST_API_URL="https://your-backend-url.com"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/saas_db"



# NextAuth Configuration
# Generate a new secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# For production, use your actual domain. For development, this is optional.
NEXTAUTH_URL="http://localhost:3000"



GOOGLE_CLIENT_ID="yourcode"
GOOGLE_CLIENT_SECRET="yourcode"




# Stripe: subscriptions (create Price IDs in Stripe Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
MONTHLY_PRICE="10"
ANNUAL_PRICE="80"



# SMTP: mail server for welcome, password reset, and transactional emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
# Optional: from address. Default: SMTP_USER or noreply@eprod.io
SMTP_FROM_EMAIL="noreply@eprod.io"

# Optional: /api/test-smtp — override recipient (default: adil.abbadi.1996@gmail.com)
# SMTP_TEST_TO_EMAIL=""
# Optional: separate secret for SMTP test; if unset, NEXTAUTH_SECRET is used
# SMTP_TEST_SECRET=""



